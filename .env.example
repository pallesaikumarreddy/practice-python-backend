# Copy to .env and fill in real values.
# .env is gitignored — never commit credentials.
#
# For AWS-hosted deployments (ECS, EC2, Lambda) prefer an IAM Role
# over long-lived access keys; boto3 will pick up role credentials
# automatically and the AWS_ACCESS_KEY_ID / SECRET vars below can
# be left empty.

# ── AWS credentials (local dev only — use IAM Role in production) ────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_SESSION_TOKEN=          # only needed for assumed / temporary role credentials
AWS_DEFAULT_REGION=us-east-1

# ── S3 configuration ─────────────────────────────────────────────────────────
S3_BUCKET_NAME=my-registration-bucket
S3_PREFIX=welcome/           # trailing slash creates a logical folder

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
